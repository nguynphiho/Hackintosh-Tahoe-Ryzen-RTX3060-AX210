+                IOLog("ItlIwx: %s warm-reboot recovery succeeded on preinit attempt %d\n",
+                      DEVNAME(sc), attempt + 1);
+            break;
+        }
+        IOLog("ItlIwx: %s preinit attempt %d/%d failed (err=%d), resetting hardware\n",
+              DEVNAME(sc), attempt + 1, kMaxPreinitAttempts, err);
+        if (attempt + 1 < kMaxPreinitAttempts) {
+            if (attempt == 1)
+                iwx_pcie_flr_reset(sc);
+            DELAY(50000);
+        }
     }
-    
-    err = iwx_run_init_mvm_ucode(sc, 1);
-    if (generation != sc->sc_generation)
-        return ENXIO;
-    iwx_stop_device(sc);
     if (err)
         return err;
     
