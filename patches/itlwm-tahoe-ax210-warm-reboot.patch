+        err = iwx_start_hw(sc);
+        if (!err) {
+            err = iwx_run_init_mvm_ucode(sc, 1);
+            if (generation != sc->sc_generation &&
+                (sc->sc_flags & IWX_FLAG_SHUTDOWN))
+                return ENXIO;
+        }
+        iwx_stop_device(sc);
+        sc->sc_flags &= ~IWX_FLAG_HW_ERR;
+        task_del(systq, &sc->init_task);
+        if (!err) {
